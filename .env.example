# MCP Proxy Server Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - add to .gitignore

# ============================================================================
# Authentication Mode
# ============================================================================
# The proxy supports three auth modes, applied in this precedence order:
#
#   1. MCP_DISABLE_AUTH=true  -> no authentication (local debugging ONLY)
#   2. MCP_AUTH_TOKEN=<token> -> shared static token (behind a gateway)
#   3. otherwise              -> Google OAuth (direct Claude.ai connections)
#
# Exactly one mode is active, and it is logged at startup.

# --- Mode 2: Static shared token (gateway-fronted deployments) --------------
# Use this when an upstream gateway (e.g. agentgateway) terminates the real
# OAuth flow and forwards requests here with a fixed header:
#     Authorization: Bearer <MCP_AUTH_TOKEN>
#
# Generate with: openssl rand -hex 32
# Minimum 32 characters; shorter values are rejected at startup.
#
# This mode has no per-user identity, no expiry, and no rotation. It is NOT a
# substitute for network scoping -- set MCP_HOST so only the gateway can reach
# the proxy (e.g. MCP_HOST=127.0.0.1 when the gateway is on the same host).
# MCP_AUTH_TOKEN=

# --- Mode 1: Disable auth entirely ------------------------------------------
# Leaves the proxy completely open to anything that can reach the port.
# Never enable this on a host reachable from an untrusted network.
# MCP_DISABLE_AUTH=false

# ============================================================================
# Mode 3: Google OAuth Configuration
# Required unless MCP_AUTH_TOKEN or MCP_DISABLE_AUTH is set above.
# Get these values from https://console.developers.google.com/
# ============================================================================

# Google OAuth 2.0 Client ID
# Found in: APIs & Services → Credentials → OAuth 2.0 Client IDs → Your Client
# Format: 123456789-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=123456789-abc123def456.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret
# Found in: APIs & Services → Credentials → OAuth 2.0 Client IDs → Your Client
# Format: GOCSPX-abc123def456...
GOOGLE_CLIENT_SECRET=GOCSPX-abc123def456ghi789jkl012

# Public URL where your MCP Proxy is accessible
# This must match the authorized redirect URI in Google Cloud Console
# Examples:
#   - https://mcp.your-domain.com (production with HTTPS)
#   - http://localhost:8080 (for local development)
#
# IMPORTANT: Add this URL + /auth/callback to Google Cloud Console:
# - Authorized redirect URIs: https://mcp.your-domain.com/auth/callback
# - Authorized JavaScript origins: https://mcp.your-domain.com
MCP_BASE_URL=https://mcp.your-domain.com

# JWT Signing Key (Optional, recommended for production)
# Generate with: openssl rand -hex 32
# This is used to sign JWT tokens for production deployments
# Leave empty for development (FastMCP will use a default key)
GOOGLE_JWT_KEY=

# ============================================================================
# MCP Proxy Configuration
# ============================================================================

# Path to MCP servers configuration
MCP_CONFIG_PATH=mcp_config.json

# Host address to bind to (0.0.0.0 = all interfaces)
# If an upstream gateway on this same host is the only intended caller, bind to
# 127.0.0.1 instead so the proxy is not reachable from the rest of the network.
MCP_HOST=0.0.0.0

# Port to listen on
MCP_PORT=8080

# Enable live config reloading (watches mcp_config.json for changes)
# Options: true, false
MCP_LIVE_RELOAD=true

# Maximum retries for loading configuration
MCP_MAX_RETRIES=3

# Initial restart delay in seconds
MCP_RESTART_DELAY=5

# ============================================================================
# Optional: Logging Configuration
# ============================================================================
# Global log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MCP_LOG_LEVEL=INFO

# Per-logger levels (comma-separated)
# Format: "logger1:LEVEL,logger2:LEVEL"
# Example: MCP_LOG_LEVELS="fastmcp:DEBUG,httpx:INFO"
MCP_LOG_LEVELS=

# Verbose auth debugging (drops fastmcp.auth loggers to DEBUG)
# Options: true, false
# MCP_AUTH_DEBUG=false

# ============================================================================
# Optional: Cloudflare Tunnel (for secure public access without exposing ports)
# ============================================================================
# Get this from: https://dash.cloudflare.com → Access → Tunnels → Your Tunnel
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
